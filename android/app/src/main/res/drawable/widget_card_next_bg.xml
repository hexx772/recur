<?xml version="1.0" encoding="utf-8"?>
<!-- Ближайшее списание: тональная карточка другого цвета и формы. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_tertiary_c" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item
        android:width="56dp"
        android:height="56dp"
        android:bottom="16dp"
        android:end="16dp"
        android:gravity="bottom|end">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_primary_c" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:end="18dp"
        android:gravity="top|end"
        android:top="18dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_secondary_c" />
        </shape>
    </item>
</layer-list>
