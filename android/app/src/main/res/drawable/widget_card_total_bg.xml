<?xml version="1.0" encoding="utf-8"?>
<!-- Итог за месяц: тональная карточка с декоративными формами Expressive. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_primary_c" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item
        android:width="52dp"
        android:height="52dp"
        android:end="16dp"
        android:gravity="top|end"
        android:top="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_tertiary_c" />
        </shape>
    </item>
    <item
        android:width="30dp"
        android:height="30dp"
        android:end="78dp"
        android:gravity="top|end"
        android:top="34dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_secondary_c" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
